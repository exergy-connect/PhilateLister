---
# Consolidate per-period catalogue JSON for one country into an XP artefact.
#
#   xform consolidate.xp --final xp --with country=china
#
# Merges output/<country>/YYYY-YYYY.json → output/<country>/collection.xp.

{% include "file://./filters/consolidate.js" %}
{% include "file://./filters/scrape.js" %}
{% include "file://./filters/country.js" %}
{% include "file://./filters/write_output.js" %}

_final:
  _templates: file://./templates/_final/

country: ""
output_dir: output

_capability:
  consolidate:
    periods:
      _input: country
      _output: collection
      _transform: "{{ _input | load_country | consolidate_country(output_dir) | write_collection_xp(output_dir) }}"

_document:
  _final: consolidate.periods
---
