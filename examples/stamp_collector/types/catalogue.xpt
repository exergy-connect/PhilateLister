---
catalogue:
  _extends: _url
  _decode: from_catalogue_string
  _encode: to_catalogue_string

  # Common StampWorld category labels (country packs may use a subset).
  category:
    - "Postage stamps"
    - "Postage-due stamps"

  # Period slugs are country-specific (e.g. 1990-1999); not enumerated here.
  period: _string

  _attributes:
    country: _string
    category: category
    period: period
    page: _integer

catalog_query:
  _attributes:
    country: _string
    categories: [catalogue.category]
    periods: [_string]
---
