---
# StampWorld catalogue collector.
# For each category×period: load
#   output/<country>/<category>.<period>.<code>.json
# when present, otherwise download, attach thumbnails, and write that file.
#
#   xform stamp_collector.xp --final json --auto-approve --with target_country=china
#
# Re-fetch existing periods with:
#   --with refresh=true
#
# Optional overrides:
#   --with max_pages=2          # 0 = all pages (default)
#   --with delay_ms=250         # pause between page fetches
#   --with year=1990            # keep only sets from this year ("" = all)
#   --with output_dir=output    # root for per-country directories
#   --with offline=true         # never fetch (also auto when CI=true)

# Filters only (no type pack include — skill xform.min.js has no packaged _type index).
{% include "file://./filters/thumbnails.js" %}
{% include "file://./filters/scrape.js" %}
{% include "file://./filters/collect.js" %}
{% include "file://./filters/country.js" %}

_final:
  _templates: file://./templates/_final/

# Country instance type. xForm resolves its named-root instances from this
# location and derives `_id` from the selected instance name.
country:
  _templates: file://./countries/

# Selected via --with target_country=china.
target_country: ""

year: ""
max_pages: "0"
delay_ms: "250"
refresh: false
offline: false
output_dir: output

# Declare an abstract collection concept
collection:

_capability:
  collect:
    stamps:
      _input: country
      _output: collection
      _content:
        scrape: "{{ _input | as_catalog_query | collect_catalogue(max_pages, delay_ms, year, refresh, output_dir, offline) }}"

---
===
{{ country[ target_country ] | collect.stamps | _final() }}
...
