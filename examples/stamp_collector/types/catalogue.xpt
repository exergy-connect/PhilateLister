---
catalogue:
  _extends: _url
  _decode: from_catalogue_string
  _encode: to_catalogue_string

  category:
    - "Postage stamps"
    - "Postage-due stamps"

  period:
    - "1949-1949"
    - "1949-2026"
    - "1950-1959"
    - "1960-1969"
    - "1970-1979"
    - "1980-1989"
    - "1990-1999"
    - "2000-2009"
    - "2010-2019"
    - "2020-2026"

  _attributes:
    country: _string
    category: category
    period: period
    page: _integer

catalog_query:
  _attributes:
    country: _string
    categories: [catalogue.category]
    periods: [catalogue.period]
---
