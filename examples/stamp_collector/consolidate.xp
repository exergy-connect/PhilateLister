---
# Consolidate per-period catalogue JSON for one country into an XP artefact.
#
#   xform consolidate.xp --final xp --with target_country=china
#
# Merges output/<country>/YYYY-YYYY.json → output/<country>/collection.xp.

{% include "file://./filters/consolidate.js" %}
{% include "file://./filters/scrape.js" %}
{% include "file://./filters/country.js" %}
{% include "file://./filters/write_output.js" %}

_final:
  _templates: file://./templates/_final/

country:
  _templates: file://./countries/

target_country: ""
output_dir: output

# Declare an abstract collection concept
collection:

_capability:
  consolidate:
    periods:
      _input: country
      _output: collection
      _realization:
        jinja: "{{ _input | consolidate_country(output_dir) | write_collection_xp(output_dir) }}"

---
===
{{ country[ target_country ] | consolidate.periods | _final() }}
...
