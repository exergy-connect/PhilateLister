---
# Find Chinese Sets — identify Chinese stamp sets by picture
# and denomination. Compose with --final html.
#
# Demo catalog:
#   xform filters.js index.xp --final html
#
# Load consolidated stamp_collector catalogue:
#   1) xform ../stamp_collector/stamp_collector.xp --final json --auto-approve
#   2) xform ../stamp_collector/consolidate.xp --final xp --auto-approve
#   3) xform filters.js index.xp --final html

title: Find Chinese Sets
tagline: Match a stamp to its set by looking, then selecting the face values you see.

_final:
  _templates: file://./templates/_final/

{% include "file://./filters/finder_catalog.js" %}

application:
  _templates: file://./templates/application/

style:
  _templates: file://./templates/style/
  ink: "#141210"
  paper: "#f2f0eb"
  seal: "#b91c1c"
  jade: "#0f766e"
  mist: "#d6d3cd"
  muted: "#5c574f"
  font_display: '"Source Serif 4", "Noto Serif SC", "Songti SC", serif'
  font_ui: '"IBM Plex Sans", "Noto Sans SC", "PingFang SC", sans-serif'

# Shape for catalog entries (and body directives that extend the catalog).
stamp_set:
  _attributes:
    id: _string
    name: _string
    name_zh: _string
    year:
      _type: _integer
      _required: true
    year_end: _integer
    denominations:
      _type: [_string]
      _required: true
    catalog: _string
    era: [imperial, republic, prc]
    image: _string
    image_full: _string
    _content: _string

# Consolidated stamp_collector artefact (bare JSON in .xp).
# Clear or override with --with collector_doc= to use only the demo catalog.
collector_doc: "file://../stamp_collector/output/china_collection.xp"

# Demo catalog — used when collector_doc is empty / unavailable.
catalog:
  sets:
    - id: large-dragon
      name: Large Dragon
      name_zh: 大龙邮票
      year: 1878
      denominations: [1c, 3c, 5c]
      catalog: "China 1–3"
      era: imperial
      image: images/large-dragon.svg
      note: First Customs Post issue — classic three-value set.

    - id: dowager
      name: Dowager Empress
      name_zh: 慈禧寿辰
      year: 1894
      denominations: [1c, 2c, 3c, 4c, 5c, 6c, 9c, 12c, 24c]
      catalog: "China 16–24"
      era: imperial
      image: images/dowager.svg
      note: Birthday commemorative; often collected as a complete set.

    - id: junk
      name: Junk Issue
      name_zh: 帆船邮票
      year: 1913
      year_end: 1933
      denominations: [½c, 1c, 1½c, 2c, 3c, 4c, 5c, 6c, 7c, 8c, 10c]
      catalog: "China 202+"
      era: republic
      image: images/junk.svg
      note: Long-running definitive; many printings and overprints.

    - id: sun-yat-sen
      name: Sun Yat-sen
      name_zh: 孙中山像
      year: 1931
      year_end: 1948
      denominations: [1c, 2c, 4c, 5c, 10c, 20c, 25c, 50c, 1元]
      catalog: "China 270+"
      era: republic
      image: images/sun-yat-sen.svg
      note: Portrait definitive series across multiple printings.

    - id: chrysanthemum
      name: Chrysanthemums
      name_zh: 菊花
      year: 1960
      year_end: 1961
      denominations: [4分, 8分, 10分, 20分, 22分, 30分, 50分, 1元]
      catalog: "S44 / Scott 506–517"
      era: prc
      image: images/chrysanthemum.svg
      note: Eighteen-value floral set — easy to spot by bloom color.

    - id: mei-lanfang
      name: Mei Lanfang Stage Art
      name_zh: 梅兰芳舞台艺术
      year: 1962
      denominations: [4分, 8分, 10分, 20分, 22分, 30分, 50分, 3元]
      catalog: "C94 / Scott 620–627"
      era: prc
      image: images/mei-lanfang.svg
      note: Famous opera set; souvenir sheet is a key piece.

    - id: monkey-t46
      name: Year of the Monkey
      name_zh: 庚申年
      year: 1980
      denominations: [8分]
      catalog: "T46 / Scott 1586"
      era: prc
      image: images/monkey-t46.svg
      note: Single 8-fen value — the iconic modern Chinese set.

    - id: terracotta
      name: Terracotta Warriors
      name_zh: 秦始皇陵兵马俑
      year: 1983
      denominations: [4分, 8分, 10分, 20分]
      catalog: "T88 / Scott 1840–1843"
      era: prc
      image: images/terracotta.svg
      note: Four-value archaeological commemorative.

    - id: panda-1985
      name: Giant Panda
      name_zh: 大熊猫
      year: 1985
      denominations: [8分, 10分, 20分, 80分]
      catalog: "T106 / Scott 1987–1990"
      era: prc
      image: images/panda-1985.svg
      note: Wildlife set — black-and-white panda motif.

    - id: scenery-1998
      name: China Scenic Spots
      name_zh: 中国风景名胜
      year: 1998
      denominations: [50分, 80分, 1元, 1.50元, 2元, 3元, 4.20元, 5.40元]
      catalog: "1998-18"
      era: prc
      image: images/scenery-1998.svg
      note: Multi-value scenic definitive-style commemorative.

# Sets shown in the UI — collector when available, else demo catalog.
# Denomination chips are derived in the browser from this list.
finder_sets: "{{ collector_doc | load_finder_sets(catalog.sets) }}"
filter: "{{ finder_sets | finder_controls }}"

_document:
  application: finder
---
# Optional body directives — same shape as catalog.sets entries.
...
