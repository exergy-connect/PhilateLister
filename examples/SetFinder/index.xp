---
# Set Finder — identify stamp sets by picture and denomination.
# Compose with --final html. Catalogs load at runtime from the shared
# public/catalogs/ tree (../catalogs/ relative to the deployed page).
# Build artefacts are still written to ./catalogs/ by scripts/build-catalogs.mjs;
# CI publishes that folder once to public/catalogs/ for SetFinder and AlbumView.
#
# Demo / build:
#   node scripts/build-catalogs.mjs
#   xform filters.js index.xp --final html
# Then compile and deploy the exported API in the xFrame lab. Image replacement
# is provided by /api/index/image/upload and persists images under
# images/<country code>/.
#
# Refresh China catalogue from stamp_collector:
#   1) xform ../stamp_collector/stamp_collector.xp --final json --auto-approve --with target_country=china
#   2) xform ../stamp_collector/consolidate.xp --final xp --with target_country=china
#   3) node scripts/build-catalogs.mjs
#   4) xform filters.js index.xp --final html

title: Set Finder
tagline: Match a stamp to its set by looking, then selecting the face values you see.
_final:
  _templates: file://./templates/_final/

{% include "file://./filters/finder_catalog.js" %}

application:
  _templates: file://./templates/application/

style:
  _templates: file://./templates/style/
  ink: "#141210"
  paper: "#f2f0eb"
  seal: "#b91c1c"
  jade: "#0f766e"
  mist: "#d6d3cd"
  muted: "#5c574f"
  font_display: '"Source Serif 4", "Noto Serif SC", "Songti SC", serif'
  font_ui: '"IBM Plex Sans", "Noto Sans SC", "PingFang SC", sans-serif'

# Shape for catalog entries (documentation / body directives).
stamp_set:
  _attributes:
    id: _string
    name: _string
    name_zh: _string
    year:
      _type: _integer
      _required: true
    year_end: _integer
    denominations:
      _type: [_string]
      _required: true
    catalog: _string
    era: _string
    image: _string
    image_full: _string
    perforation: _string
    _content: _string

image_upload:
  _attributes:
    country:
      _type: _string
      _required: true
    catalog:
      _type: _string
      _required: true
    set:
      _type: _string
      _required: true
    index:
      _type: _integer
      _required: true
    content_type: _string
    data: _string
    url: _url

image_upload_result:
  _attributes:
    path: _string
    url: _url
    error: _string

_capability:
  image:
    upload:
      _api: _true
      _input: image_upload
      _output: image_upload_result
      _realization:
        jinja: "{{ _input | _validate() | upload_image }}"

_document:
  application: finder
---
# Optional body directives — same shape as catalog set entries.
# Country catalogues: build into catalogs/*.json; served from public/catalogs/.
...
